    },
    "flightNo": {
      "ui:placeholder": "e.g. ZZ 101"
    },
    "diverted": {
      "ui:widget": "radio",
      "ui:options": {
        "inline": true
      }
    },
    "startTimeUtc": {
      "ui:placeholder": "HH:MM"
    },
    "recoveredAutomatically": {
      "ui:widget": "radio",
      "ui:options": {
        "inline": true
      }
    },
    "timeError": {
