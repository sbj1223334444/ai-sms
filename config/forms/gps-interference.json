{
  "meta": {
    "formId": "gps-interference",
    "code": "GPS-001",
    "title": "GPS RFI Interference Report",
    "summary": "GPS jamming, spoofing or loss of position integrity.",
    "supportsConfidential": false,
    "attachmentsRequired": false
  },
  "schema": {
    "type": "object",
    "required": [
      "mobileNo",
      "dateOfEvent",
      "flightNo",
      "diverted",
      "flightPhase",
      "startLocation",
      "startTimeUtc",
      "countryRegion",
      "recoveredAutomatically",
      "description"
    ],
    "properties": {
      "mobileNo": {
        "type": "string",
        "title": "Mobile number",
        "maxLength": 255,
        "pattern": "^[0-9]{10}$"
      },
      "dateOfEvent": {
        "type": "string",
        "format": "date",
        "title": "Date of event"
      },
      "flightNo": {
        "type": "string",
        "title": "Flight number",
        "maxLength": 10,
        "pattern": "^[A-Za-z0-9]{2,3} ?[0-9]{1,4}[A-Za-z]?$"
      },
      "flightDate": {
        "type": "string",
        "format": "date",
        "title": "Flight date"
      },
      "diverted": {
        "type": "string",
        "title": "Did the aircraft divert?",
        "enum": [
          "Yes",
          "No"
        ]
      },
      "flightPhase": {
        "type": "string",
        "title": "Flight phase",
        "enum": [
          "Take-off",
          "Climb",
          "Cruise",
          "Descent",
          "Approach",
          "On the ground: at the bay",
          "On the ground: taxi in",
          "On the ground: taxi out"
        ]
      },
      "startLocation": {
        "type": "string",
        "title": "Approximate start location",
        "maxLength": 255
      },
      "startTimeUtc": {
        "type": "string",
        "title": "Approximate start of event (UTC)",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "countryRegion": {
        "type": "string",
        "title": "Country / region where GPS interference was observed",
