      }
    },
    "otherEcamEicas": {
      "ui:widget": "radio",
      "ui:options": {
        "inline": true
      }
    },
    "description": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 5,
        "fullWidth": true
      }
    },
    "otherInformation": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "fullWidth": true
      }
    },
    "ui:groups": [
      {
        "title": "Reporter information",
        "fields": [
          "mobileNo"
        ]
      },
      {
        "title": "General information",
        "description": "Aircraft type and series, registration, and the airfields of departure and destination are filled in automatically from CAE after you submit. You do not need to enter them.",
        "fields": [
          "dateOfEvent",
          "flightNo",
          "flightDate",
          "diverted",
          "flightPhase",
          "startLocation",
          "startTimeUtc",
          "countryRegion",
          "recoveredAutomatically"
        ]
      },
      {
        "title": "Possible effect",
        "fields": [
          "timeError",
          "dateError",
          "positionError",
          "terrainAlert",
          "adsbLoss",
          "anpEpuDegradation",
          "otherEcamEicas"
        ]
      },
      {
        "title": "Flight crew actions",
        "fields": [
