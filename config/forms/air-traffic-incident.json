      "ui:placeholder": "10-digit number"
    },
    "ui:groups": [
      {
        "title": "Section A: Aircraft identification",
        "fields": [
          "aircraftIdentification",
          "incidentType"
        ]
      },
      {
        "title": "Section B: The incident, general",
        "fields": [
          "dateTimeOfIncident",
          "position"
        ]
      },
      {
        "title": "Section C: Own aircraft",
        "fields": [
          "headingRoute",
          "trueAirspeed",
          "levelAltimeter",
          "ownClimbDescend",
          "ownBankAngle",
          "ownBankDirection",
          "visibilityRestrictions",
          "ownLighting",
          "ownAtsAvoidance",
          "ownTrafficInfo",
          "acas",
          "acasType",
          "identification",
          "otherAircraftSighted",
          "ownAvoidingAction",
          "flightPlanType",
          "vfr"
        ]
      },
      {
        "title": "Section D: Other aircraft",
        "fields": [
          "otherTypeCallsign",
          "otherDescription",
          "otherMarkings",
          "otherClimbDescend",
          "otherBankAngle",
          "otherBankDirection",
          "otherLights",
          "otherAtsAvoidance",
          "otherTrafficInfo",
          "otherAvoidingAction"
        ]
      },
      {
        "title": "Section E: Distance",
        "fields": [
          "closestHorizontal",
          "closestVertical"
        ]
      },
      {
        "title": "Section F: Flight weather conditions",
        "fields": [
          "imcVmc",
          "imcVmcDetail",
          "cloudPosition",
          "cloudPositionDetail",
          "distanceBelowCloud",
          "distanceAboveCloud",
          "inWeather",
          "inWeatherDetail",
          "sun",
          "flightVisibility"
        ]
      },
      {
        "title": "Section G: Additional information",
        "fields": [
          "description"
        ]
      },
      {
        "title": "Section H: Miscellaneous",
        "fields": [
          "miscRegistration",
          "miscAircraftType",
          "miscOperator",
          "aerodromeDeparture",
          "destination",
          "aerodromeFirstLanding",
          "reportedByRadio",
          "completionDetails"
        ]
      },
      {
        "title": "Section J: Person submitting report",
        "description": "Your function and address are taken from your account. The signature is added on the printed report.",
        "fields": [
          "submitterTelephone"
        ]
      },
      {
        "title": "Section K: Person receiving report",
        "description": "Completed by the person who receives the report, not by the reporter.",
        "fields": []
      },
      {
        "title": "Section L: Diagrams of airprox",
        "description": "The sheet attached to the paper form. Click a grid to place a mark, or use the arrow keys.",
        "fields": [
          "airproxDiagram"
        ]
      }
    ],
    "airproxDiagram": {
      "ui:field": "airproxDiagram",
      "ui:options": {
        "fullWidth": true
      }
    }
  }
}
