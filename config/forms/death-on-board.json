        "title": "Seat number",
        "maxLength": 255
      },
      "companionName": {
        "type": "string",
        "title": "Name of relative or other companion",
        "maxLength": 255
      },
      "timeOfDeath": {
        "type": "string",
        "title": "Time of death",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "lastMeal": {
        "type": "string",
        "title": "Last meal partaken",
        "maxLength": 2000
      },
      "specialInstructions": {
        "type": "string",
        "title": "Special instructions given at embarkation",
        "maxLength": 2000
      },
      "doctorNurseDetails": {
        "type": "string",
        "title": "Doctor / nurse details",
        "maxLength": 2000
      },
      "otherInformation": {
        "type": "string",
        "title": "Any other relevant information",
        "maxLength": 2000
      },
      "description": {
        "type": "string",
        "title": "Death on board: description",
        "minLength": 100,
        "maxLength": 5000
      }
    }
  },
  "uiSchema": {
    "contactNo": {
      "ui:placeholder": "10-digit number"
    },
    "flightNo": {
      "ui:placeholder": "e.g. ZZ 101"
    },
    "address": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 3
      }
    },
    "gender": {
      "ui:widget": "radio",
      "ui:options": {
        "inline": true
      }
    },
    "seatNo": {
      "ui:placeholder": "e.g. 23C"
    },
    "timeOfDeath": {
      "ui:placeholder": "HH:MM"
    },
    "lastMeal": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "fullWidth": true
      },
      "ui:help": "What was served, and when."
    },
    "specialInstructions": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "fullWidth": true
      }
    },
    "doctorNurseDetails": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "fullWidth": true
      },
      "ui:help": "Name, address and phone of the attending medical professional."
    },
    "otherInformation": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 4,
        "fullWidth": true
      }
    },
    "description": {
      "ui:widget": "textarea",
      "ui:options": {
        "rows": 6,
        "fullWidth": true
      },
      "ui:help": "Details of the occurrence and the actions taken by the crew. At least 100 characters."
    },
    "ui:groups": [
      {
        "title": "Reporter information",
        "description": "Your name, staff number and email are taken from your account.",
        "fields": [
          "contactNo",
          "base"
        ]
      },
      {
        "title": "Flight information",
        "description": "Aircraft type, sector and registration are filled in automatically from CAE after you submit. You do not need to enter them.",
        "fields": [
          "flightNo",
          "flightDate",
          "phaseOfFlight",
          "dateOfEvent"
        ]
      },
      {
        "title": "Crew details",
        "description": "The cabin supervisor and crew details (up to 14 crew) are filled in automatically from CAE after you submit. You do not need to enter them.",
        "fields": []
      },
      {
        "title": "Passenger details",
        "fields": [
          "deceasedName",
          "address",
          "age",
          "gender",
          "nationality",
          "passportNo",
          "seatNo",
          "companionName",
          "timeOfDeath",
          "lastMeal",
          "specialInstructions",
          "doctorNurseDetails",
          "otherInformation"
        ]
      },
      {
        "title": "Occurrence description",
        "fields": [
          "description"
        ]
      },
      {
        "title": "Documents to attach",
        "description": "Attach below: cabin crew work allocation sheet, Death on Board form, CDLB (if applicable), Form A (if applicable), crew statements, boarding card (passenger details), MedAire facility used, and any other picture supporting the report.",
        "fields": []
      }
    ]
  }
}
