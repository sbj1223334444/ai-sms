{
  "meta": {
    "formId": "death-on-board",
    "code": "DOB-001",
    "title": "Death on Board Report",
    "summary": "Death of a passenger on board the aircraft.",
    "supportsConfidential": false,
    "attachmentsRequired": true
  },
  "schema": {
    "type": "object",
    "required": [
      "contactNo",
      "base",
      "flightNo",
      "flightDate",
      "phaseOfFlight",
      "dateOfEvent",
      "deceasedName",
      "address",
      "age",
      "gender",
      "nationality",
      "passportNo",
      "seatNo",
      "timeOfDeath",
      "description"
    ],
    "properties": {
      "contactNo": {
        "type": "string",
        "title": "Contact number",
        "maxLength": 255,
        "pattern": "^[0-9]{10}$"
      },
      "base": {
        "type": "string",
        "title": "Base",
        "enum": [
          "DEL",
          "BOM",
          "BLR",
          "MAA",
          "CCU",
          "HYD",
          "AMD",
          "COK",
          "GOI",
          "PNQ",
          "LHR",
          "JFK",
          "SIN",
          "DXB",
          "SYD"
        ]
      },
      "flightNo": {
        "type": "string",
        "title": "Flight number",
        "maxLength": 10,
        "pattern": "^[A-Za-z0-9]{2,3} ?[0-9]{1,4}[A-Za-z]?$"
      },
      "flightDate": {
        "type": "string",
        "format": "date",
        "title": "Flight date"
      },
      "phaseOfFlight": {
        "type": "string",
        "title": "Phase of flight",
        "enum": [
          "Parked",
          "Taxiing",
          "Take-off",
          "Initial climb",
          "Climb",
          "Cruise",
          "Descent",
          "Holding",
          "Approach",
          "Landing",
          "Circuit"
        ]
      },
      "dateOfEvent": {
        "type": "string",
        "format": "date",
        "title": "Date of event"
      },
      "deceasedName": {
        "type": "string",
        "title": "Name of deceased passenger",
        "maxLength": 255
      },
      "address": {
        "type": "string",
        "title": "Address",
        "maxLength": 2000
      },
      "age": {
        "type": "integer",
        "title": "Age",
        "minimum": 0,
        "maximum": 130
      },
      "gender": {
        "type": "string",
        "title": "Male / female",
        "enum": [
          "Male",
          "Female"
        ]
      },
      "nationality": {
        "type": "string",
