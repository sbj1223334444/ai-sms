    "ui:groups": [
      {
        "title": "Section A: Date and time of incident",
        "description": "The report number is issued automatically when you submit.",
        "fields": [
          "dateTimeOfIncident",
          "dayNight"
        ]
      },
      {
        "title": "Section B: Person submitting report",
        "description": "Your name and job title are taken from your account.",
        "fields": [
          "telephone",
          "facilityUnit",
          "completionDetails"
        ]
      },
      {
        "title": "Section C: ICAO aerodrome designator",
        "fields": [
          "icaoAerodrome"
        ]
      },
      {
        "title": "Section D: Surface condition",
        "fields": [
          "surfaceCondition"
        ]
      },
      {
        "title": "Section E: Aircraft, vehicle or person involved",
        "fields": [
          "aircraft1",
          "aircraft2",
          "aircraft3",
          "vehicle",
          "person"
        ]
      },
      {
        "title": "Section F: Weather conditions",
        "fields": [
          "wind",
          "visibilityRvr",
          "temperatureC",
          "ceilingCloud",
          "weatherAdditional"
        ]
      },
      {
        "title": "Section G: Evasive action, aircraft 1",
        "fields": [
          "evasiveAircraft1",
          "evasiveAircraft1Actions",
          "distanceRolled1",
          "distanceToThreshold1"
        ]
      },
      {
        "title": "Section H: Evasive action, aircraft 2",
        "fields": [
          "evasiveAircraft2",
          "evasiveAircraft2Actions",
          "distanceRolled2",
          "distanceToThreshold2"
        ]
      },
      {
        "title": "Section I: Evasive action, vehicle",
        "fields": [
          "evasiveVehicle",
          "evasiveVehicleActions"
        ]
      },
      {
        "title": "Section J: Closest proximity",
        "fields": [
          "cpVerticalFt",
          "cpHorizontalM"
        ]
      },
      {
        "title": "Section K: Communication difficulties",
        "fields": [
          "commDifficulties",
          "commDifficultyTypes"
        ]
      },
      {
        "title": "Section L: ATC",
        "fields": [
          "atcForgot"
        ]
      },
      {
        "title": "Section M: Description of incident",
        "description": "To include a diagram, attach it with the attachments below.",
        "fields": [
          "description",
          "evasiveActionDescription",
          "reactionTimeAssessment",
          "voiceCommReview",
          "severityAssessment"
        ]
      },
      {
        "title": "Section N: Aircraft details, aircraft 1",
        "fields": [
          "ac1Registration",
          "ac1CallSign",
          "ac1Ssr",
          "ac1FlightNo",
          "ac1Operator",
          "ac1Type",
          "ac1FlightType",
          "ac1FlightRules"
        ]
      },
      {
        "title": "Section O: Aircraft details, aircraft 2",
        "fields": [
          "aircraft2Involved",
          "ac2Registration",
          "ac2CallSign",
          "ac2Ssr",
          "ac2FlightNo",
          "ac2Operator",
          "ac2Type",
          "ac2FlightType",
          "ac2FlightRules"
        ]
      },
      {
        "title": "Section P: Vehicle details, vehicle 1",
        "fields": [
          "vehicleInvolved",
          "veh1Registration",
          "veh1CallSign",
          "veh1Type",
          "veh1Owner",
          "veh1PermitNo",
          "veh1OtherDetails",
          "veh1Other"
        ]
      },
      {
        "title": "Section Q: Report received by",
        "description": "Name, designation, organisation and date of the person receiving the report are filled in automatically.",
        "fields": []
      },
      {
        "title": "Section R: Investigation",
        "description": "The person or agency responsible for the investigation, and the likely completion date, are set by the safety team, not the reporter.",
        "fields": []
      }
    ]
  }
