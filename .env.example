# ---------- Nothing here is required locally ----------
# With no variables set at all, `npm run dev` runs on an in-memory store with three seeded
# reports and the ten demo accounts. In production only NEXTAUTH_SECRET is required.

# ---------- Session ----------
# Required in production (Vercel included): next-auth refuses to start without it.
# Generate one with `openssl rand -base64 32`. Locally, any string works.
NEXTAUTH_SECRET=any_random_string_will_do
NEXTAUTH_URL=http://localhost:3000

# ---------- Durable storage (optional) ----------
# Set all three and data is written to a private GitHub repo instead of memory,
# with every change recorded as a commit. Run `npm run seed` once after setting them.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DATA_REPO=
GITHUB_BRANCH=main

# ---------- Email (optional) ----------
# Leave blank and notifications are written to the server console instead of sent.
SMTP_URL=
MAIL_FROM=safety@airindia.com

# ---------- CAE (not connected) ----------
# Crew and aircraft are entered by hand. See src/lib/cae.ts for what to fill in
# if CAE Crew Management and Movement Manager access is granted later.
# CAE_API_URL=
# CAE_API_TOKEN=
